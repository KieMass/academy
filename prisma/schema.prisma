// Red Bay Academy — database schema
//
// Design principle: this schema is YEAR-GROUP AGNOSTIC. `Subject` and `Topic`
// rows are never hand-written — they are generated by `prisma/seed.ts` from
// the curriculum map JSON files in `content/curriculum/*.json`. When a new
// year group (e.g. Y6) is added to those JSON files and the seed is re-run,
// new Topic rows appear automatically; no migration or schema change needed.
// `YearGroup` covers the whole of Key Stage 2 up front for exactly this reason.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local/dev. Swap to `provider = "postgresql"` + a POSTGRES_URL
  // env var for production — see docs/DEPLOYMENT.md. Field types below
  // (String, Json-as-String, etc.) are deliberately chosen to be portable
  // across both.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & accounts
// ---------------------------------------------------------------------------

enum Role {
  PARENT
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  role         Role
  email        String?  @unique // parents log in with email
  username     String?  @unique // students log in with a short username
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentProfile  ParentProfile?
  studentProfile StudentProfile?

  sessions Session[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ParentProfile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String

  students StudentProfile[]

  createdAt DateTime @default(now())
}

enum YearGroup {
  Y3
  Y4
  Y5
  Y6
}

model StudentProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  avatarEmoji String    @default("🦊")
  yearGroup   YearGroup @default(Y5)
  dateOfBirth DateTime?

  parentId String
  parent   ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  // Gamification
  xpTotal      Int      @default(0)
  levelNumber  Int      @default(1)
  streakDays   Int      @default(0)
  lastActiveAt DateTime?

  // Accessibility preferences (dyslexia-friendly font, font scale, contrast, read-aloud)
  accessibilityPrefs String @default("{}") // JSON blob, see lib/accessibility/types.ts

  attempts      QuestionAttempt[]
  spellingRuns  SpellingRun[]
  masteries     TopicMastery[]
  badges        StudentBadge[]
  xpEvents      XpEvent[]
  assignments   Assignment[]
  worksheets    Worksheet[]

  createdAt DateTime @default(now())

  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Curriculum-derived catalogue (generated by prisma/seed.ts — do not hand-edit)
// ---------------------------------------------------------------------------

model Subject {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "maths" — matches content/curriculum/<slug>.json
  name      String
  icon      String
  color     String
  frameworks String  @default("[]") // JSON string array

  topics     Topic[]
  worksheets Worksheet[]

  createdAt DateTime @default(now())
}

model Topic {
  id             String    @id @default(cuid())
  subjectId      String
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  strandSlug     String // e.g. "fractions"
  strandName     String
  yearGroup      YearGroup
  description    String?
  order          Int       @default(0)

  questions ContentQuestion[]
  masteries TopicMastery[]

  createdAt DateTime @default(now())

  @@unique([subjectId, strandSlug, yearGroup])
  @@index([yearGroup])
}

// ---------------------------------------------------------------------------
// Question engine
// ---------------------------------------------------------------------------

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_IN_BOX
  MULTI_STEP
  DRAG_DROP
  MATCHING
  SHORT_ANSWER
}

enum DifficultyBand {
  BRONZE
  SILVER
  GOLD
  CHALLENGE
}

enum ContentSource {
  SEED
  PARENT_ADDED
  AI_GENERATED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Generic, extensible question record. `prompt`, `options` and `answer` are
/// JSON strings whose shape depends on `type` — see lib/question-engine/types.ts
/// for the discriminated-union TypeScript contract every reader/writer uses.
model ContentQuestion {
  id             String         @id @default(cuid())
  topicId        String
  topic          Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  objectiveCode  String // curriculum map objective code, e.g. "MA5-FRAC-3"
  type           QuestionType
  difficulty     DifficultyBand
  prompt         String // JSON: { text, media? }
  options        String? // JSON: choice/matching/drag-drop option sets
  answer         String // JSON: canonical answer + acceptable variants
  explanation    String? // shown in immediate feedback
  tags           String  @default("[]") // JSON string array, free-form

  // Reading-specific linkage (nullable for non-reading subjects)
  passageId String?
  passage   ReadingPassage? @relation(fields: [passageId], references: [id], onDelete: Cascade)
  subSkill  String? // literal | inference | prediction | vocabulary | author-intent | summarising | retrieval

  source ContentSource @default(SEED)
  status ContentStatus @default(PUBLISHED)

  attempts QuestionAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId, difficulty])
  @@index([status])
}

enum PassageType {
  FICTION
  NON_FICTION
  POETRY
}

model ReadingPassage {
  id         String      @id @default(cuid())
  title      String
  type       PassageType
  yearGroup  YearGroup
  bodyText   String
  wordCount  Int
  author     String?
  source     ContentSource @default(SEED)
  status     ContentStatus @default(PUBLISHED)

  questions ContentQuestion[]

  createdAt DateTime @default(now())
}

model QuestionAttempt {
  id              String   @id @default(cuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId      String
  question        ContentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response        String // JSON: student's raw response
  isCorrect       Boolean
  timeSpentSeconds Int
  assignmentId    String?
  assignment      Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  attemptedAt DateTime @default(now())

  @@index([studentId, questionId])
  @@index([assignmentId])
}

enum MasteryLevel {
  NOT_STARTED
  DEVELOPING
  SECURE
  MASTERED
}

model TopicMastery {
  id                 String       @id @default(cuid())
  studentId          String
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId            String
  topic              Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionsAttempted Int          @default(0)
  questionsCorrect   Int          @default(0)
  masteryLevel       MasteryLevel @default(NOT_STARTED)
  lastPracticedAt    DateTime?

  @@unique([studentId, topicId])
}

// ---------------------------------------------------------------------------
// Spelling module (weekly lists, look-cover-write-check, dictation, tests)
// ---------------------------------------------------------------------------

model SpellingList {
  id         String   @id @default(cuid())
  weekLabel  String // e.g. "Week 1 - Autumn Term"
  yearGroup  YearGroup
  strandSlug String // links to content/curriculum/spelling.json strand
  words      String // JSON string array of { word, definition?, exampleSentence? }
  source     ContentSource @default(SEED)

  runs SpellingRun[]

  createdAt DateTime @default(now())
}

enum SpellingMode {
  LOOK_COVER_WRITE_CHECK
  WORD_SORT
  DICTATION
  TEST
}

model SpellingRun {
  id             String       @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  spellingListId String
  spellingList   SpellingList @relation(fields: [spellingListId], references: [id], onDelete: Cascade)
  mode           SpellingMode
  results        String // JSON: [{ word, correct, attempts }]
  score          Int
  totalWords     Int

  completedAt DateTime @default(now())

  @@index([studentId, spellingListId])
}

// ---------------------------------------------------------------------------
// Assignments (parent -> student) and printable worksheets
// ---------------------------------------------------------------------------

enum AssignmentType {
  PRACTICE
  WORKSHEET
  ASSESSMENT
  INTERVENTION
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

model Assignment {
  id         String           @id @default(cuid())
  studentId  String
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdByParentId String
  type       AssignmentType
  title      String
  topicIds   String // JSON string array of Topic ids
  dueDate    DateTime?
  status     AssignmentStatus @default(ASSIGNED)

  attempts QuestionAttempt[]

  createdAt DateTime @default(now())
}

enum WorksheetKind {
  TEN_QUESTION
  TWENTY_QUESTION
  ASSESSMENT
  INTERVENTION
}

model Worksheet {
  id          String        @id @default(cuid())
  createdByStudentId String?
  student     StudentProfile? @relation(fields: [createdByStudentId], references: [id], onDelete: SetNull)
  subjectId   String
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicIds    String // JSON string array of Topic ids
  kind        WorksheetKind
  studentName String // name printed on the PDF (may differ from account name)
  questionIds String // JSON string array of ContentQuestion ids, frozen at generation time

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

model Badge {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String
  criteria    String // JSON: machine-readable unlock rule, see lib/gamification/badges.ts

  awardedTo StudentBadge[]
}

model StudentBadge {
  id        String   @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  @@unique([studentId, badgeId])
}

enum XpReason {
  QUESTION_CORRECT
  ASSIGNMENT_COMPLETE
  STREAK_BONUS
  BADGE_BONUS
  SPELLING_TEST
}

model XpEvent {
  id        String   @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  points    Int
  reason    XpReason
  meta      String   @default("{}") // JSON context, e.g. { questionId }

  createdAt DateTime @default(now())

  @@index([studentId])
}

// ---------------------------------------------------------------------------
// AI content generation staging (never published without review)
// ---------------------------------------------------------------------------

enum AiContentType {
  QUESTION
  PASSAGE
  REVISION_TASK
  HOMEWORK_SET
}

enum AiReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model AiGeneratedContent {
  id             String         @id @default(cuid())
  type           AiContentType
  targetTopicId  String?
  payload        String // JSON: shape matches ContentQuestion/ReadingPassage draft
  promptContext  String @default("{}") // JSON: what was asked for (topic, difficulty, student weaknesses)
  status         AiReviewStatus @default(PENDING_REVIEW)
  reviewedByParentId String?
  reviewNotes    String?

  createdAt DateTime @default(now())
  reviewedAt DateTime?
}
