// KaeLex Academy — database schema
//
// Design principle: this schema is YEAR-GROUP AGNOSTIC. `Subject` and `Topic`
// rows are never hand-written — they are generated by `prisma/seed.ts` from
// the curriculum map JSON files in `content/curriculum/*.json`. When a new
// year group (e.g. Y6) is added to those JSON files and the seed is re-run,
// new Topic rows appear automatically; no migration or schema change needed.
// `YearGroup` covers the whole of Key Stage 2 up front for exactly this reason.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres (Neon) — shared by local dev and production. Field types below
  // (String, Json-as-String, etc.) were deliberately chosen to be portable,
  // in case this ever needs to move providers again.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & accounts
// ---------------------------------------------------------------------------

enum Role {
  PARENT
  STUDENT
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  role         Role
  email        String?  @unique // parents log in with email
  username     String?  @unique // students log in with a short username
  passwordHash String
  colorScheme  String   @default("ocean") // one of THEME_COLOR_SCHEMES in lib/theme/color-schemes.ts — validated in the API route, not a DB enum, so new schemes can be added without a migration
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentProfile  ParentProfile?
  studentProfile StudentProfile?

  sessions              Session[]
  passwordResetRequests PasswordResetRequest[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A national curriculum a Family follows — e.g. Cayman Islands (the
// original, UK-National-Curriculum-derived content) or Guyana (CXC/NGSA-
// aligned). Topic is scoped by curriculum in addition to (subject, strand,
// yearGroup), so the exact same YearGroup value (Y1-Y6) can mean "Year 5"
// for one family and "Grade 5" for another — see yearGroupLabel.
model Curriculum {
  id             String   @id @default(cuid())
  slug           String   @unique // "cayman", "guyana"
  name           String // "Cayman Islands", "Guyana"
  yearGroupLabel String   @default("Year") // "Year" -> "Year 5"; Guyana uses "Grade" -> "Grade 5"
  description    String?
  createdAt      DateTime @default(now())

  topics   Topic[]
  families Family[]
}

// A Family groups together every parent who should have full, equal access
// to the same set of students — e.g. two co-parents. A student still belongs
// to a single "owning" ParentProfile (the one who added them, via
// StudentProfile.parentId) for simple record-keeping, but every "my
// students"-style query is scoped by familyId, not parentId, so any parent
// in the family sees and manages the same children.
model Family {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // The national curriculum this family follows — required. Every family
  // is created with one, either at registration
  // (src/app/api/auth/register-parent) or via the parent-facing
  // "change curriculum" setting (src/app/api/parent/family/curriculum).
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)

  parents ParentProfile[]

  @@index([curriculumId])
}

model ParentProfile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  students StudentProfile[]

  createdAt DateTime @default(now())

  @@index([familyId])
}

enum YearGroup {
  Y1
  Y2
  Y3
  Y4
  Y5
  Y6
}

model StudentProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  avatarEmoji String    @default("🦊")
  yearGroup   YearGroup @default(Y5)
  dateOfBirth DateTime?

  parentId String
  parent   ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  // Gamification
  xpTotal      Int       @default(0)
  levelNumber  Int       @default(1)
  streakDays   Int       @default(0)
  lastActiveAt DateTime?

  // Accessibility preferences (dyslexia-friendly font, font scale, contrast, read-aloud)
  accessibilityPrefs String @default("{}") // JSON blob, see lib/accessibility/types.ts

  attempts     QuestionAttempt[]
  spellingRuns SpellingRun[]
  masteries    TopicMastery[]
  badges       StudentBadge[]
  xpEvents     XpEvent[]
  assignments  Assignment[]
  worksheets   Worksheet[]
  flags        QuestionFlag[]

  createdAt DateTime @default(now())

  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Curriculum-derived catalogue (generated by prisma/seed.ts — do not hand-edit)
// ---------------------------------------------------------------------------

model Subject {
  id         String @id @default(cuid())
  slug       String @unique // e.g. "maths" — matches content/curriculum/<slug>.json
  name       String
  icon       String
  color      String
  frameworks String @default("[]") // JSON string array

  topics     Topic[]
  worksheets Worksheet[]

  createdAt DateTime @default(now())
}

model Topic {
  id          String    @id @default(cuid())
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  strandSlug  String // e.g. "fractions"
  strandName  String
  yearGroup   YearGroup
  description String?
  order       Int       @default(0)

  // The curriculum this topic belongs to — required. The same (subjectId,
  // strandSlug, yearGroup) triple can exist under more than one curriculum
  // with entirely different content.
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)

  questions        ContentQuestion[]
  masteries        TopicMastery[]
  contentGapAlerts ContentGapAlert[]

  createdAt DateTime @default(now())

  @@unique([subjectId, strandSlug, yearGroup, curriculumId])
  @@index([yearGroup])
  @@index([curriculumId])
}

// ---------------------------------------------------------------------------
// Question engine
// ---------------------------------------------------------------------------

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_IN_BOX
  MULTI_STEP
  DRAG_DROP
  MATCHING
  SHORT_ANSWER
}

enum DifficultyBand {
  BRONZE
  SILVER
  GOLD
  CHALLENGE
}

enum ContentSource {
  SEED
  PARENT_ADDED
  AI_GENERATED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Generic, extensible question record. `prompt`, `options` and `answer` are
/// JSON strings whose shape depends on `type` — see lib/question-engine/types.ts
/// for the discriminated-union TypeScript contract every reader/writer uses.
model ContentQuestion {
  id            String         @id @default(cuid())
  topicId       String
  topic         Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  objectiveCode String // curriculum map objective code, e.g. "MA5-FRAC-3"
  type          QuestionType
  difficulty    DifficultyBand
  prompt        String // JSON: { text, media? }
  options       String? // JSON: choice/matching/drag-drop option sets
  answer        String // JSON: canonical answer + acceptable variants
  explanation   String? // shown in immediate feedback
  tags          String         @default("[]") // JSON string array, free-form

  // Reading-specific linkage (nullable for non-reading subjects)
  passageId String?
  passage   ReadingPassage? @relation(fields: [passageId], references: [id], onDelete: Cascade)
  subSkill  String? // literal | inference | prediction | vocabulary | author-intent | summarising | retrieval

  source ContentSource @default(SEED)
  status ContentStatus @default(PUBLISHED)

  attempts QuestionAttempt[]
  flags    QuestionFlag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId, difficulty])
  @@index([status])
}

enum QuestionFlagStatus {
  PENDING_PARENT_REVIEW
  PENDING_ADMIN_REVIEW
  DISMISSED_BY_PARENT
  DISMISSED_BY_ADMIN
  REMOVED
}

/// Student-initiated "this question is broken" report. Flows
/// student -> parent (triage) -> admin (final removal), mirroring the
/// review-then-act shape of ContentGapAlert. Reviewer ids are stored as
/// plain strings (not relations) the same way AiGeneratedContent.
/// reviewedByParentId already does — no back-relation needed on
/// ParentProfile/User for this.
model QuestionFlag {
  id         String          @id @default(cuid())
  questionId String
  question   ContentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  reason        String // canned reason label the student picked
  note          String? // optional free-text detail
  studentAnswer String? // JSON snapshot of what they'd answered, if any, for context

  status QuestionFlagStatus @default(PENDING_PARENT_REVIEW)

  reviewedByParentId String?
  parentNotes        String?
  parentReviewedAt   DateTime?

  reviewedByAdminId String? // User.id — admins have no dedicated profile model
  adminNotes        String?
  adminReviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([questionId])
  @@index([studentId])
  @@index([status])
}

enum ContentGapStatus {
  PENDING
  DISMISSED
}

/// A "this topic's question pool is being recycled too hard" alert for
/// admins, raised automatically from /api/attempts (see lib/content-gap.ts)
/// once a topic's total attempts-per-question ratio crosses a threshold.
/// At most one PENDING alert exists per topic at a time; dismissing one
/// doesn't delete it (so there's a record of when it was raised/actioned),
/// and a fresh alert for the same topic only fires again once usage has
/// grown meaningfully further past the dismissal point — otherwise the very
/// next attempt after a dismiss would just recreate it.
model ContentGapAlert {
  id            String           @id @default(cuid())
  topicId       String
  topic         Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status        ContentGapStatus @default(PENDING)
  questionCount Int // published questions in the pool when this was raised
  attemptCount  Int // total attempts against that pool when this was raised
  createdAt     DateTime         @default(now())
  dismissedAt   DateTime?

  @@index([topicId, createdAt])
  @@index([status])
}

enum PassageType {
  FICTION
  NON_FICTION
  POETRY
}

model ReadingPassage {
  id        String        @id @default(cuid())
  title     String
  type      PassageType
  yearGroup YearGroup
  bodyText  String
  wordCount Int
  author    String?
  source    ContentSource @default(SEED)
  status    ContentStatus @default(PUBLISHED)

  questions ContentQuestion[]

  createdAt DateTime @default(now())
}

model QuestionAttempt {
  id               String          @id @default(cuid())
  studentId        String
  student          StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId       String
  question         ContentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response         String // JSON: student's raw response
  isCorrect        Boolean
  timeSpentSeconds Int
  assignmentId     String?
  assignment       Assignment?     @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  attemptedAt DateTime @default(now())

  @@index([studentId, questionId])
  @@index([assignmentId])
}

enum MasteryLevel {
  NOT_STARTED
  DEVELOPING
  SECURE
  MASTERED
}

model TopicMastery {
  id                 String         @id @default(cuid())
  studentId          String
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId            String
  topic              Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionsAttempted Int            @default(0)
  questionsCorrect   Int            @default(0)
  masteryLevel       MasteryLevel   @default(NOT_STARTED)
  lastPracticedAt    DateTime?

  @@unique([studentId, topicId])
}

// ---------------------------------------------------------------------------
// Spelling module (weekly lists, look-cover-write-check, dictation, tests)
// ---------------------------------------------------------------------------

model SpellingList {
  id         String        @id @default(cuid())
  weekLabel  String // e.g. "Week 1 - Autumn Term"
  yearGroup  YearGroup
  strandSlug String // links to content/curriculum/spelling.json strand
  words      String // JSON string array of { word, definition?, exampleSentence? }
  source     ContentSource @default(SEED)

  runs SpellingRun[]

  createdAt DateTime @default(now())
}

enum SpellingMode {
  LOOK_COVER_WRITE_CHECK
  WORD_SORT
  DICTATION
  TEST
}

model SpellingRun {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  spellingListId String
  spellingList   SpellingList   @relation(fields: [spellingListId], references: [id], onDelete: Cascade)
  mode           SpellingMode
  results        String // JSON: [{ word, correct, attempts }]
  score          Int
  totalWords     Int

  completedAt DateTime @default(now())

  @@index([studentId, spellingListId])
}

// ---------------------------------------------------------------------------
// Assignments (parent -> student) and printable worksheets
// ---------------------------------------------------------------------------

enum AssignmentType {
  PRACTICE
  WORKSHEET
  ASSESSMENT
  INTERVENTION
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model Assignment {
  id                String           @id @default(cuid())
  studentId         String
  student           StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdByParentId String
  type              AssignmentType
  title             String
  topicIds          String // JSON string array of Topic ids
  dueDate           DateTime?
  status            AssignmentStatus @default(ASSIGNED)

  attempts QuestionAttempt[]

  createdAt DateTime @default(now())
}

enum WorksheetKind {
  TEN_QUESTION
  TWENTY_QUESTION
  ASSESSMENT
  INTERVENTION
}

model Worksheet {
  id                 String          @id @default(cuid())
  createdByStudentId String?
  student            StudentProfile? @relation(fields: [createdByStudentId], references: [id], onDelete: SetNull)
  subjectId          String
  subject            Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicIds           String // JSON string array of Topic ids
  kind               WorksheetKind
  studentName        String // name printed on the PDF (may differ from account name)
  questionIds        String // JSON string array of ContentQuestion ids, frozen at generation time

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

model Badge {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String
  criteria    String // JSON: machine-readable unlock rule, see lib/gamification/badges.ts

  awardedTo StudentBadge[]
}

model StudentBadge {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge          @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime       @default(now())

  @@unique([studentId, badgeId])
}

enum XpReason {
  QUESTION_CORRECT
  ASSIGNMENT_COMPLETE
  STREAK_BONUS
  BADGE_BONUS
  SPELLING_TEST
}

model XpEvent {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  points    Int
  reason    XpReason
  meta      String         @default("{}") // JSON context, e.g. { questionId }

  createdAt DateTime @default(now())

  @@index([studentId])
}

// ---------------------------------------------------------------------------
// AI content generation staging (never published without review)
// ---------------------------------------------------------------------------

enum AiContentType {
  QUESTION
  PASSAGE
  REVISION_TASK
  HOMEWORK_SET
}

enum AiReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model AiGeneratedContent {
  id                 String         @id @default(cuid())
  type               AiContentType
  targetTopicId      String?
  payload            String // JSON: shape matches ContentQuestion/ReadingPassage draft
  promptContext      String         @default("{}") // JSON: what was asked for (topic, difficulty, student weaknesses)
  status             AiReviewStatus @default(PENDING_REVIEW)
  reviewedByParentId String?
  reviewNotes        String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

// ---------------------------------------------------------------------------
// Account recovery
// ---------------------------------------------------------------------------

enum PasswordResetRequestStatus {
  PENDING
  FULFILLED
  DISMISSED
}

// There's no email service wired up, so "forgot password" can't reset
// anything automatically — it records a request an admin can see and act on
// (generating a new one-time password, same as the existing admin-initiated
// reset). userId is nullable so a request for an email/username that doesn't
// exist can still be recorded without leaking whether the account exists
// (the submitter always sees the same generic confirmation).
model PasswordResetRequest {
  id          String                     @id @default(cuid())
  identifier  String // whatever the user typed in (email or username), for the admin to see
  userId      String?
  user        User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      PasswordResetRequestStatus @default(PENDING)
  createdAt   DateTime                   @default(now())
  fulfilledAt DateTime?

  @@index([status])
}

// Fixed-window rate-limit counters (see src/lib/rate-limit.ts). Backed by
// Postgres rather than in-memory because this app runs on Vercel's
// serverless functions — separate invocations don't share process memory,
// so an in-memory counter would silently reset per-instance and give no
// real protection. One row per (endpoint, identity) window; rows are
// naturally reused across windows (see the upsert in checkRateLimit) so
// this table stays small — no cleanup job needed.
model RateLimitBucket {
  key       String   @id // e.g. "login:ip:203.0.113.5" or "attempts:student:<id>"
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ---------------------------------------------------------------------------
// Data retention
// ---------------------------------------------------------------------------

enum RetentionMode {
  ASSIGNMENT_COUNT // keep each student's most recent `value` assignments
  DAYS // keep assignments created within the last `value` days
}

// Single-row, system-wide policy for how long assignment results (an
// Assignment plus its QuestionAttempt rows) are kept before
// purgeExpiredResults() (see lib/retention.ts) deletes them. Tuned from the
// admin settings page; upserted under a fixed id rather than relying on a
// generated one, same convention as RateLimitBucket.key above. lastPurgedAt
// lets purging piggyback on regular request traffic (see maybePurgeExpiredResults,
// called from /api/attempts) without needing a cron job.
model ResultsRetentionSetting {
  id           String        @id
  mode         RetentionMode @default(ASSIGNMENT_COUNT)
  value        Int           @default(20)
  lastPurgedAt DateTime?
  updatedAt    DateTime      @updatedAt
}
