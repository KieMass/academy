# Local development (SQLite) — copy this file to .env and adjust as needed.
DATABASE_URL="file:./dev.db"

# Session signing secret (jose HS256). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string-in-production"

# --- Production (PostgreSQL) ---
# Swap `provider = "sqlite"` for `provider = "postgresql"` in prisma/schema.prisma,
# then set:
# DATABASE_URL="postgresql://user:password@host:5432/redbay_academy"
