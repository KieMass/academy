# Postgres connection string — shared by local dev, Docker and production.
# `docker compose up` provides one automatically; for local dev without
# Docker, point this at your own Postgres instance (e.g. a free Neon DB).
DATABASE_URL="postgresql://user:password@host:5432/academy"

# Session signing secret (jose HS256). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string-in-production"
